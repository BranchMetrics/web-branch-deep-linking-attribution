{
  "name": "branch-sdk",
  "version": "0.0.0",
  "description": "Branch Metrics Deep Linking/Smart Banner Web SDK",
  "main": "dist/build.min.js",
  "files": [
    "dist/build.min.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "ci": "npm ci",
    "clean": "rimraf dist coverage test-results.xml",
    "clean-and-develop": "npm ci && npm run clean && npm run build && npm run cover",
    "cover": "vitest run --coverage",
    "format": "biome lint --only=correctness/noUnusedImports --write . && biome format --write .",
    "format:check": "biome ci --linter-enabled=false .",
    "test": "vitest run",
    "test-debug": "vitest --inspect-brk --no-file-parallelism",
    "test-report": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=test-results.xml",
    "test:min": "vitest run --config vitest.min.config.mjs",
    "prepare": "husky",
    "validate": "npm ls",
    "start:dev": "node startDev.js",
    "release": "rimraf dist && node scripts/build.mjs",
    "lint:src": "biome lint --only=correctness/noUndeclaredVariables --only=correctness/noUnusedVariables --only=correctness/noUnusedImports src",
    "test:bundle": "vitest run --config vitest.bundle.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BranchMetrics/web-branch-deep-linking-attribution.git"
  },
  "author": "Dmitri Gaskin <dmitrig01@gmail.com>",
  "contributors": [
    "Jagadeesh Karicherla"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BranchMetrics/web-branch-deep-linking-attribution/issues",
    "email": "support@branch.io"
  },
  "homepage": "https://help.branch.io/developers-hub/docs/web-sdk-overview",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@vitest/coverage-v8": "^5.0.3",
    "husky": "^9.1.7",
    "inquirer": "^14.2.2",
    "jsdom": "^26.1.0",
    "rimraf": "^6.1.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
