{
  "name": "branch-sdk",
  "version": "0.0.0",
  "description": "Branch Metrics Deep Linking/Smart Banner Web SDK",
  "main": "dist/build.min.js",
  "files": [
    "dist/build.min.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "ci": "npm ci",
    "clean": "npm-run-all clean:*",
    "clean:dist": "rimraf dist/*",
    "clean:coverage": "rimraf coverage",
    "clean:test-report": "rimraf test-results.xml",
    "clean-and-develop": "npm-run-all ci clean build cover",
    "commit": "git-cz",
    "cover": "vitest run --coverage",
    "lint": "biome lint . || true",
    "format": "biome lint --only=correctness/noUnusedImports --write . && biome format --write .",
    "format:check": "biome ci --linter-enabled=false .",
    "test": "vitest run",
    "test-debug": "vitest --inspect-brk --no-file-parallelism",
    "test-report": "vitest run --reporter=default --reporter=junit --outputFile.junit=test-results.xml",
    "builddocs": "jsdox src/3_branch_web.js --output docs/web",
    "prepare": "husky install",
    "validate": "npm ls",
    "start:dev": "node startDev.js",
    "release": "npm-run-all clean:dist build",
    "lint:src": "biome lint --only=correctness/noUndeclaredVariables --only=correctness/noUnusedVariables --only=correctness/noUnusedImports src",
    "test:bundle": "vitest run --config vitest.bundle.config.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BranchMetrics/web-branch-deep-linking-attribution.git"
  },
  "author": "Dmitri Gaskin <dmitrig01@gmail.com>",
  "contributors": [
    "Jagadeesh Karicherla"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/BranchMetrics/web-branch-deep-linking-attribution/issues",
    "email": "support@branch.io"
  },
  "homepage": "https://help.branch.io/developers-hub/docs/web-sdk-overview",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@vitest/coverage-v8": "^5.0.3",
    "commitizen": "^4.3.0",
    "cz-customizable": "^7.0.0",
    "husky": "^9.0.11",
    "inquirer": "^9.2.15",
    "jsdom": "24.0.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^5.0.1",
    "sinon": "16.0.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "build": "2.71.0",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}
