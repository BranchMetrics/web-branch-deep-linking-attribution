{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom"],
    "types": [],
    "strict": false,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/**/*.ts"],
  // The loader snippet customers paste into their pages, not part of the bundle.
  "exclude": ["src/snippet/onpage.js"]
}
