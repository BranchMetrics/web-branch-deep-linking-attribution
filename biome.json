{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["src/**", "test/**", "package.json", "biome.json"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "useArrowFunction": "off"
      },
      "correctness": {
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        }
      },
      "suspicious": {
        "noPrototypeBuiltins": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "formatWithErrors": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "preserve"
    },
    "globals": ["define", "ActiveXObject"]
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error",
            "noUnusedVariables": {
              "level": "error",
              "fix": "none"
            }
          }
        }
      }
    },
    {
      "includes": ["test/**/*.html", "src/banner/stars/**/*.svg"],
      "linter": {
        "rules": {
          "a11y": "off"
        }
      }
    },
    {
      "includes": ["src/**/*.js", "test/**/*.js", "!test/blob-*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noVar": "error"
          },
          "style": {
            "useConst": "error"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.js"],
      "linter": {
        "rules": {
          "style": {
            "useTemplate": "off"
          }
        }
      }
    },
    {
      "includes": ["src/snippet/onpage.js"],
      "linter": {
        "rules": {
          "complexity": {
            "noArguments": "off",
            "useOptionalChain": "off"
          },
          "suspicious": {
            "noRedundantUseStrict": "off"
          }
        }
      }
    },
    {
      "includes": ["test/blob-*.js"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["src/core/storage.js", "test/core/storage.test.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    }
  ]
}
