{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": ["src/**", "test/**", "package.json", "biome.json"]
  },
  "linter": {
    "rules": {
      "complexity": {
        "useArrowFunction": "off"
      },
      "correctness": {
        "noUnusedImports": { "level": "error", "fix": "safe" }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "formatWithErrors": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "quoteProperties": "preserve"
    },
    "globals": ["define", "ActiveXObject"]
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "error",
            "noUnusedVariables": { "level": "error", "fix": "none" }
          }
        }
      }
    }
  ]
}
